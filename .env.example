# Word AI Configuration
# Copy this file to .env and adjust values as needed

# Storage path for attachment files
WORD_AI_STORAGE_PATH=./data/attachments

# Max file size in bytes (default: 50MB = 52428800)
WORD_AI_MAX_FILE_SIZE=52428800

# Max batch upload count (default: 20)
WORD_AI_MAX_BATCH=20

# Allowed file extensions (comma-separated)
WORD_AI_ALLOWED_EXT=pdf,txt,md,json,csv,docx,xlsx,png,jpg,gif

# Rate limiting - time window in ms (default: 60000 = 1 min)
WORD_AI_RATE_WINDOW=60000

# Rate limiting - max requests per window (default: 20)
WORD_AI_RATE_MAX=20

# Session TTL in seconds (default: 7 days = 604800)
WORD_AI_SESSION_TTL=604800

# Shell command timeout in ms (default: 30000 = 30s)
WORD_AI_SHELL_TIMEOUT=30000

# CORS origins (comma-separated)
WORD_AI_CORS_ORIGINS=http://localhost:*

# HTTP server port (default: 3141)
WORD_AI_HTTP_PORT=3141
