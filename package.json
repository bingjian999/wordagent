{
  "name": "word-ai",
  "version": "0.1.0",
  "description": "Word AI - Attachment platform and tool extensions for Pi Agent",
  "type": "module",
  "scripts": {
    "lint": "eslint src/ extensions/",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "typebox": "^1.3.7",
    "express": "^4.19.0",
    "multer": "^2.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions/demo/index.ts",
      "./extensions/attachments/index.ts",
      "./extensions/tools/index.ts"
    ]
  }
}
